# Build stage: compile a fully static-ish release binary.
FROM rust:1.83-slim-bookworm AS builder

WORKDIR /build
RUN apt-get update \
 && apt-get install -y --no-install-recommends pkg-config \
 && rm -rf /var/lib/apt/lists/*

# Copy the manifest first so dependency compilation is cached between builds.
COPY node/Cargo.toml ./Cargo.toml
RUN mkdir -p src \
 && echo 'fn main() {}' > src/main.rs \
 && echo '' > src/lib.rs \
 && cargo build --release \
 && rm -rf src

COPY node/src ./src
COPY node/tests ./tests
# Touch so cargo does not reuse the dummy build artifacts.
RUN touch src/main.rs src/lib.rs && cargo build --release

# Runtime stage: no toolchain, no build deps.
FROM debian:bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --create-home --uid 10001 cog

COPY --from=builder /build/target/release/cog-node /usr/local/bin/cog-node

USER cog
WORKDIR /home/cog
VOLUME ["/data"]

# 26657 JSON-RPC (miners and wallets), 26656 P2P gossip (other validators).
EXPOSE 26657 26656

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -fsS http://127.0.0.1:26657/health || exit 1

ENTRYPOINT ["cog-node"]
CMD ["run", "--genesis", "/config/genesis.json", "--data-dir", "/data", \
     "--rpc", "0.0.0.0:26657", "--p2p", "0.0.0.0:26656"]
